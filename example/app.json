{
  "expo": {
    "name": "LiteRT-LM Provider",
    "slug": "ai-sdk-litert-lm-example",
    "scheme": "litertlmprovider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "dev.aisdklitertlm.example",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.aisdklitertlm.example",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-litert-lm",
        {
          "ios": {
            "extendedVirtualAddressing": true,
            "increasedMemoryLimit": true
          }
        }
      ]
    ]
  }
}
